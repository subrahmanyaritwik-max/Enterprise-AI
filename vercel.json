{
  "version": 2,
  "buildCommand": "npm run build --prefix OPSpulse/FRONTEND",
  "outputDirectory": "OPSpulse/FRONTEND/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
